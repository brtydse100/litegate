# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-your-litellm-master-key

# ── Generic OIDC ──────────────────────────────────────────────────────────────
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups

# Comma-separated identities that receive administrator access
ADMIN_EMAILS=
ADMIN_GROUPS=

# ── Session JWT (generate with: openssl rand -hex 32) ────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# Optional API-only administrator credential
MANAGEMENT_API_KEY=

# ── Root URL (for SSO redirect after login) ──────────────────────────────────
ROOT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Key Defaults (leave empty to use LiteLLM defaults) ───────────────────────
KEY_MAX_BUDGET=
KEY_BUDGET_DURATION=
KEY_MODELS=[]
KEY_TPM_LIMIT=
KEY_RPM_LIMIT=
KEY_DURATION=
KEY_TEAM_ID=

# ── Temporary local login (remove in production) ──────────────────────────────
# Set both to enable username/password login on the login page
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_PASSWORD=

# Persistent local-user database
LOCAL_USER_DB_PATH=data/litegate.db
