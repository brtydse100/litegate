# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-your-litellm-master-key
# Verify outgoing LiteLLM and SSO HTTPS certificates; prefer a trusted CA bundle.
SSL_VERIFY=true

# ── OIDC SSO ──────────────────────────────────────────────────────────────────
OIDC_ISSUER_URL=https://accounts.google.com
# Optional manual provider endpoints. Set all three or leave all three unset.
# OIDC_AUTHORIZATION_ENDPOINT=https://accounts.example.com/oauth2/authorize
# OIDC_TOKEN_ENDPOINT=https://accounts.example.com/oauth2/token
# OIDC_JWKS_URI=https://accounts.example.com/oauth2/keys
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_SCOPES=openid email profile
# Alternative: generic OAuth SSO. Clear OIDC_ISSUER_URL and manual OIDC endpoints
# before enabling this mode. All five credentials/endpoints are required.
# GENERIC_CLIENT_ID=litegate
# GENERIC_CLIENT_SECRET=replace-me
# GENERIC_AUTHORIZATION_ENDPOINT=https://login.example.com/authorize
# GENERIC_TOKEN_ENDPOINT=https://login.example.com/token
# GENERIC_USERINFO_ENDPOINT=https://login.example.com/userinfo
# GENERIC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# If unset, the callback uses ROOT_URL + /api/auth/callback.
# GENERIC_SCOPE=openid profile email
# GENERIC_USER_ID_ATTRIBUTE=sub
# GENERIC_USER_EMAIL_ATTRIBUTE=email
# GENERIC_CLIENT_USE_PKCE=false
# GENERIC_INCLUDE_CLIENT_ID=true
# Reject email_verified: false; false permits explicitly unverified email.
# GENERIC_REQUIRE_VERIFIED_EMAIL=true
# The following group/team and administrator settings apply to either SSO mode.
OIDC_GROUPS_CLAIM=groups
# JSON object: each SSO group maps to one existing LiteLLM team ID or a list.
OIDC_GROUP_TEAM_MAPPING={"Engineering":"team-engineering","AI-Platform":["team-platform","team-shared-services"]}
# Set true to deny SSO users whose groups do not match the mapping.
OIDC_REQUIRE_TEAM_MAPPING=false
# Existing team added to every SSO user in addition to mapped teams.
SSO_DEFAULT_TEAM_ID=
# Inherit only the matching LiteLLM proxy_admin role.
INHERIT_LITELLM_ADMIN=false

# Comma-separated identities that receive administrator access
ADMIN_EMAILS=
ADMIN_GROUPS=

# ── Session JWT (generate with: openssl rand -hex 32) ────────────────────────
JWT_SECRET=change-me-to-a-random-secret
# During rotation, keep the previous secret(s) here until old sessions expire.
# New sessions are always signed with JWT_SECRET. Separate multiple values with commas.
JWT_PREVIOUS_SECRETS=

# Optional API-only administrator credential
MANAGEMENT_API_KEY=

# ── Root URL (for SSO redirect after login) ──────────────────────────────────
ROOT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Key Defaults (leave empty to use LiteLLM defaults) ───────────────────────
KEY_MAX_BUDGET=
KEY_BUDGET_DURATION=
KEY_MODELS=[]
KEY_TPM_LIMIT=
KEY_RPM_LIMIT=
KEY_DURATION=
KEY_TEAM_ID=

# Optional organization hierarchy as JSON; see docs/organization.md.
# Managed users use per-user team-member budgets instead of KEY_MAX_BUDGET.
ORGANIZATION_HIERARCHY={"levels":[]}

# Store full API keys in SQLite for owners and administrators to reveal.
SAVE_API_KEYS_IN_DB=false

# ── Temporary local login (remove in production) ──────────────────────────────
# Set both to enable username/password login on the login page
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_PASSWORD=

# Persistent local-user database
LOCAL_USERS_DB_PATH=data/litegate.db

# Retain audit history for this many days; expired rows are pruned in bounded batches on audit writes.
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_BATCH_SIZE=1000
